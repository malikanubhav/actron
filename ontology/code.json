{
 "category": "code",
 "version": "1.0",
 "domain": "software_engineering",
 "summary": "The code of a repository as a graph, built deterministically with tree-sitter from a local clone, plus its git history. Covers components (packages and apps), files, classes, functions, every remaining line as chunks, markdown documentation sections, imports, external packages, calls, test-to-code links, commits, authors, branches, tags, per-file changes and the exact functions each commit touched. Function and class ids come from the qualified name, not the line number, so they stay stable when code moves. Graph metrics (callers, PageRank, criticality) are stored on functions after each ingestion. Fabric's codebase ontology was used as a reference. Links from code to GitHub, Slack, Linear, people and the meaning layer are defined in core.json. Every node also carries the shared metadata defined in core.json.",
 "core_entities": [
  "CodeFunction",
  "CodeClass",
  "CodeFile",
  "GitCommit"
 ],
 "entry_points": [
  "CodeRepository"
 ],
 "use_cases": [
  "Which functions call this function, up to three hops, and which tests cover them?",
  "What is the most depended-on code in this repository?",
  "Which commits changed this function, when, and by whom?",
  "Who wrote most of this function according to blame?",
  "Which files and functions does this package contain, and what does it depend on?",
  "Where in the docs is this function or file explained?"
 ],
 "action_classifications": [
  {
   "action_name": "Clone Repository",
   "tool_name": "clone_repository",
   "action_direction": "pull",
   "action_type": "ingestion",
   "description": "Shallow-clone or fetch the repository into the clone cache.",
   "requires_params": true,
