   "description": "Parse CODEOWNERS rules.",
   "requires_params": true,
   "source_node_types": [
    "CodeOwnerRule"
   ]
  },
  {
   "action_name": "Read Git Log",
   "tool_name": "git_log",
   "action_direction": "pull",
   "action_type": "ingestion",
   "description": "Commits, authors, parents and per-file changes with diff hunks, incrementally from the last ingested commit.",
   "requires_params": true,
   "source_node_types": [
    "GitCommit",
    "GitAuthor",
    "GitFileChange"
   ]
  },
  {
   "action_name": "Read Git Refs",
   "tool_name": "git_refs",
   "action_direction": "pull",
   "action_type": "ingestion",
   "description": "Branches and tags.",
   "requires_params": true,
   "source_node_types": [
    "GitBranch",
    "GitTag"
   ]
  },
  {
   "action_name": "Map Changes To Functions",
   "tool_name": "map_hunks",
   "action_direction": "pull",
   "action_type": "ingestion",
   "description": "Map diff hunks to the functions and classes they touched.",
   "requires_params": true,
   "source_node_types": [
    "GitCommit",
