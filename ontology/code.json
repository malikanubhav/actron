   "action_direction": "pull",
   "action_type": "ingestion",
   "description": "Walk files and parse supported languages with tree-sitter.",
   "requires_params": true,
   "source_node_types": [
    "CodeFile",
    "CodeClass",
    "CodeFunction"
   ]
  },
  {
   "action_name": "Chunk Remaining Lines",
   "tool_name": "chunk_files",
   "action_direction": "pull",
   "action_type": "ingestion",
   "description": "Cover lines outside functions and classes with overlapping chunks.",
   "requires_params": true,
   "source_node_types": [
    "CodeChunk"
   ]
  },
  {
   "action_name": "Split Documents",
   "tool_name": "split_documents",
   "action_direction": "pull",
   "action_type": "ingestion",
   "description": "Split markdown files into heading sections.",
   "requires_params": true,
   "source_node_types": [
    "CodeDocument"
   ]
  },
  {
   "action_name": "Resolve Imports And Calls",
   "tool_name": "resolve_symbols",
   "action_direction": "pull",
   "action_type": "ingestion",
   "description": "Resolve imports and call sites to files, classes and functions; count unresolved calls.",
   "requires_params": true,
   "source_node_types": [
    "CodeFunction",
    "CodeFile",
    "CodeDependency"
   ]
  },
  {
   "action_name": "Link Tests",
   "tool_name": "link_tests",
   "action_direction": "pull",
   "action_type": "ingestion",
   "description": "Mark tests and link them to the code they exercise.",
   "requires_params": true,
   "source_node_types": [
    "CodeFunction",
    "CodeFile"
   ]
  },
  {
   "action_name": "Read Codeowners",
   "tool_name": "read_codeowners",
   "action_direction": "pull",
