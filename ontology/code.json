   "description": "Line authorship per file, aggregated per function.",
   "requires_params": true,
   "source_node_types": [
    "GitAuthor",
    "CodeFunction"
   ]
  },
  {
   "action_name": "Compute Graph Metrics",
   "tool_name": "compute_metrics",
   "action_direction": "pull",
   "action_type": "ingestion",
   "description": "Caller counts, PageRank and criticality percentile over CALLS, written back to functions.",
   "requires_params": false,
   "source_node_types": [
    "CodeFunction"
   ]
  }
