# Caddy in front of Actron. HTTPS is automatic for {$ACTRON_DOMAIN}.
{$ACTRON_DOMAIN} {
	encode zstd gzip

	# Server-sent events: no buffering, no compression, long timeouts.
	@sse path /api/stream /api/requests/*/events
	handle @sse {
		reverse_proxy backend:8080 {
			flush_interval -1
			transport http {
				read_timeout 24h
				write_timeout 24h
			}
		}
	}

	# API, Slack and GitHub webhooks go straight to the backend.
	@backend path /api/* /slack/* /webhooks/*
	handle @backend {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
