  text: 'import { ReplSession } from \'./connector\';\nimport { prettyPrint } from \'./printer\';\nimport { showResult } from \'./results/output\';\nimport { autoEvaluateEnabled } from \'./settings\';\n\nexport async function evaluateCode(session: ReplSession, code: string): Promise<string> {\n  const raw = await session.eval(code);\n  const text = formatEvalResult(raw);\n  showResult(text);\n  return text;\n}\n\nexport function formatEvalResult(raw: string): string {\n  return prettyPrint(raw);\n}\n\nexport async function evaluateSelection(session: ReplSession, selection: string) {\n  return evaluateCode(session, selection);\n}\n\nexport async function evaluateTopLevelForm(session: ReplSession, form: string) {\n  return evaluateCode(session, form);\n}\n\nexport async function evaluateOnSave(session: ReplSession, document: string) {\n  if (!autoEvaluateEnabled()) {\n    return undefined;\n  }\n  return evaluateCode(session, document);\n}'}),
