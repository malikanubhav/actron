MATCH (n) SET n.workspaceId = $ws, n.ontologyVersion = $ontologyVersion, n.ingestedAt = '2026-10-01T00:00:00Z', n.refreshedAt = '2026-10-01T00:00:00Z'
;
MATCH (n) WITH n, labels(n)[0] AS l SET n.source = CASE WHEN l STARTS WITH 'Slack' THEN 'slack' WHEN l STARTS WITH 'Linear' THEN 'linear' WHEN l STARTS WITH 'Github' THEN 'github' WHEN l STARTS WITH 'Git' THEN 'git' WHEN l STARTS WITH 'Code' THEN 'code' ELSE 'actron' END
;
MATCH ()-[r]->() SET r.createdAt = '2026-10-01T00:00:00Z'
;
