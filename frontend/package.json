{
  "name": "actron-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/prepare-msw.mjs && node scripts/snapshot-ontology.mjs",
    "dev": "next dev --port 3000",
    "prebuild": "node scripts/prepare-msw.mjs && node scripts/snapshot-ontology.mjs",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:e2e-stack": "playwright test -c tests/e2e-stack/playwright.config.ts",
    "gen:types": "openapi-typescript lib/api/openapi.json -o lib/api/openapi.d.ts",
    "capture": "tsx scripts/capture-screens.ts",
    "lhci": "lhci autorun --config=lighthouserc.json",
    "build:fixtures": "NEXT_PUBLIC_ACTRON_DEV_FIXTURES=1 NEXT_DIST_DIR=.next-fixtures sh -c \"node scripts/prepare-msw.mjs && node scripts/snapshot-ontology.mjs && next build\""
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.2",
    "@phosphor-icons/react": "2.1.10",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tanstack/react-query": "5.104.3",
    "clsx": "2.1.1",
    "d3-force": "3.0.0",
    "motion": "12.43.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "shiki": "4.5.0",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/d3-force": "3.0.10",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "simple-icons": "16.35.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  }
}
