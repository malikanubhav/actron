{
  "$comment": "Lighthouse CI (spec C, C8; PROMPT 8.8a item 9). Measures the running compose stack (`make up`: production frontend, real backend, workspace dev with the Calva data) through infra/lhci/Caddyfile on :3400, which compresses like production's Caddy (Next serves uncompressed). The request is a real finished Q&A request in workspace dev (created 18 Oct 2026 by W10). /app routes need LHCI_SESSION=<actron_session cookie from a dev login>. scripts/test_all.sh starts the proxy and gets the session.",
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:3400/",
        "http://127.0.0.1:3400/app",
        "http://127.0.0.1:3400/app/requests/req_01M55ZB10PQRGAR8DV7CNFVXQC",
        "http://127.0.0.1:3400/app/connect"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new",
        "disableStorageReset": true
      },
      "puppeteerScript": "./scripts/lhci-auth.cjs",
      "puppeteerLaunchOptions": {
        "args": [
          "--no-sandbox"
        ]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.05
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://127.0.0.1:3400/$",
          "assertions": {
            "categories:seo": [
              "error",
              {
                "minScore": 0.9
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
