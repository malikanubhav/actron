# Copy to .env and fill in. Never commit .env. Every value may be empty:
# empty means the feature runs as a labelled stub or shows "not connected".

# App
ACTRON_ENV=dev
ACTRON_SECRET_KEY=          # Fernet key: encrypts connector secrets in PostgreSQL
SESSION_SECRET=             # signs the session and CSRF cookies
ACTRON_HOST=127.0.0.1       # backend (uvicorn) bind address
ACTRON_PORT=8080            # backend (uvicorn) port
ACTRON_BUILD_HOST_DIR=/var/lib/actron/builds   # build checkouts; same host path mounted into the worker

# Stores (non-default host ports to avoid collisions)
DATABASE_URL=postgresql+psycopg://actron:actron@127.0.0.1:5433/actron
REDIS_URL=redis://127.0.0.1:6380/0
FALKORDB_URL=redis://127.0.0.1:6389
FALKORDB_PORT=6389          # host port in compose.yaml
FALKORDB_GRAPH_PREFIX=actron
FALKORDB_BINDING=params     # params (default) or literal (safe single-pass binder, docs/falkordb.md 6)
FALKORDB_UNIQUE_CONSTRAINTS=   # empty: on in dev/prod, off in tests (docs/falkordb.md 12)
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=actron
TEMPORAL_UI_PORT=8233

# Slack app (app-level credentials; one app for "Add to Slack" OAuth and Sign in with Slack)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=            # xapp-..., Socket Mode fallback (can also be entered in the Connect form)
ACTRON_PUBLIC_URL=          # e.g. https://actron.example.com (OAuth redirect and webhooks)
# Development fallback only (a connection saved in the UI always wins)
SLACK_BOT_TOKEN=
SLACK_CHANNELS=

# GitHub
# GITHUB_REPOSITORY is the repo the team merges into and Actron ingests as code (for the demo: the fork).
# GITHUB_FORK is where Actron pushes branches and opens PRs (usually the same repo).
# GITHUB_UPSTREAM (optional) is read for history only.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_FORK=
GITHUB_UPSTREAM=
GITHUB_WEBHOOK_SECRET=

# Linear
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Models
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MODEL_DECISION=
MODEL_WRITING=
MODEL_AGENT=
MODEL_CODING=
LITELLM_FALLBACKS=          # optional comma list of fallback models
LINK_KEEP_THRESHOLD=0.6     # keep model-made links at or above this probability

# Build step
ACTRON_BOT_NAME=
ACTRON_BOT_EMAIL=
ACTRON_MAX_CONCURRENT_BUILDS=1
ACTRON_BUILD_TIMEOUT_SECONDS=1800
ACTRON_MAX_REPAIRS=2
ACTRON_DAILY_MODEL_BUDGET_USD=20

# Ingestion
ACTRON_CLONE_DIR=.actron/clones
ACTRON_BACKFILL_DAYS=90
ACTRON_GIT_HISTORY_DEPTH=2000

# Frontend (the browser calls same-origin /api; Next.js proxies to API_INTERNAL_URL)
API_INTERNAL_URL=http://backend:8080   # use http://127.0.0.1:8080 when running the frontend outside Docker
NEXT_PUBLIC_ACTRON_DEV_FIXTURES=0
