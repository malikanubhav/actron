# Load explicitly: set -a; source .env; set +a. Never commit .env.
FALKORDB_URL=redis://127.0.0.1:6389
FALKORDB_GRAPH=actron_demo
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
ACTRON_DEMO_USER=
ACTRON_DEMO_CHANNEL=
LINEAR_API_KEY=
LINEAR_TEAM_ID=
GITHUB_TOKEN=
GITHUB_REPOSITORY=
# Must equal GITHUB_REPOSITORY: explicit dedicated-repository restriction.
ACTRON_DEDICATED_REPOSITORY=
ACTRON_REPOSITORY=
ACTRON_ARTIFACTS=.actron/runs
ACTRON_HOST=127.0.0.1
ACTRON_PORT=8080
# JSON argv for a real coding CLI installed in your custom Docker image.
# CLI stdin: scope/evidence/base/checks/max_tokens. stdout: {"patch":"...","tokens":123}.
ACTRON_CODING_COMMAND='["python","/opt/actron_model_cli.py"]'
ACTRON_CODING_IMAGE=actron-coding
# JSON list of model-only credential ENV NAMES; never Slack/Linear/GitHub credentials.
ACTRON_CODING_ENV='["OPENAI_API_KEY","ACTRON_MODEL"]'
OPENAI_API_KEY=
ACTRON_MODEL=
ACTRON_MAX_TOKENS=12000
ACTRON_TIMEOUT=300
ACTRON_MAX_ATTEMPTS=2
ACTRON_REQUIRED_CHECKS='["suite"]'
ACTRON_REVIEWS_REQUIRED=1
